{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["draft", "assistantMessage", "warnings", "evidenceNotes"],
  "properties": {
    "draft": {
      "type": "string"
    },
    "assistantMessage": {
      "type": "string"
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidenceNotes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
