# LAIQ Report Platform runtime AI settings
#
# PostgreSQL is the only supported report-platform database. For local work,
# start compose.yaml and use this connection string.
REPORT_PLATFORM_POSTGRES_DB=laiq_report_platform
REPORT_PLATFORM_POSTGRES_USER=laiq_report_platform
REPORT_PLATFORM_POSTGRES_PASSWORD=replace-with-a-long-random-local-password
DATABASE_URL=postgresql://laiq_report_platform:replace-with-a-long-random-local-password@127.0.0.1:55432/laiq_report_platform
REPORT_PLATFORM_DB_SSL=disable
REPORT_PLATFORM_DB_POOL_MAX=20

# S3-compatible evidence storage. The API signs direct upload/download URLs;
# Android never receives these credentials. For a physical Android device,
# use a host reachable from that device (for example the server's Tailscale
# address) rather than 127.0.0.1 in REPORT_PLATFORM_S3_ENDPOINT.
REPORT_PLATFORM_S3_BUCKET=laiq-report-platform
REPORT_PLATFORM_S3_ENDPOINT=http://127.0.0.1:59000
REPORT_PLATFORM_S3_REGION=us-east-1
REPORT_PLATFORM_S3_FORCE_PATH_STYLE=true
REPORT_PLATFORM_S3_ACCESS_KEY_ID=replace-with-a-random-object-storage-user
REPORT_PLATFORM_S3_SECRET_ACCESS_KEY=replace-with-a-long-random-object-storage-password
REPORT_PLATFORM_S3_UPLOAD_URL_TTL_SECONDS=900
REPORT_PLATFORM_S3_READ_URL_TTL_SECONDS=300
REPORT_PLATFORM_UPLOAD_SESSION_TTL_MS=86400000
REPORT_PLATFORM_UPLOAD_MAX_OBJECTS=250
REPORT_PLATFORM_UPLOAD_MAX_OBJECT_BYTES=262144000
REPORT_PLATFORM_UPLOAD_MAX_EXPORT_BYTES=2147483648

# Maximum accepted JSON request size. V3 export packages are sent as JSON;
# attachment binaries require the separate object-upload phase described in
# AUTHENTICATION_AND_TENANCY.md.
REPORT_PLATFORM_MAX_JSON_BODY_BYTES=26214400

# Bind Docker dependencies to loopback by default. For direct Android uploads
# over Tailscale, use the Mac mini's stable Tailscale IP here and in the S3
# endpoint above. Do not use 0.0.0.0 for the published database port.
REPORT_PLATFORM_DATABASE_BIND_ADDRESS=127.0.0.1
REPORT_PLATFORM_OBJECT_BIND_ADDRESS=127.0.0.1
REPORT_PLATFORM_API_HOST=0.0.0.0
REPORT_PLATFORM_API_PORT=8788

# GPT-5.6 Sol is the default worker target for the internal LAIQ AI Engine phase.
# The local Codex CLI must be 0.144.0 or newer for GPT-5.6; otherwise the
# backend will report deterministic fallback mode instead of running live AI.
REPORT_PLATFORM_CODEX_MODEL=gpt-5.6-sol

# Safety timeout for each Codex CLI worker call, in milliseconds.
# Keep this finite so section generation and chat edits cannot hang the demo.
REPORT_PLATFORM_CODEX_TIMEOUT_MS=120000

# Bound local Codex CLI work so concurrent report users cannot exhaust the host.
# Jobs above the active limit wait in FIFO order and fail closed when the queue
# is full or its wait deadline expires.
REPORT_PLATFORM_CODEX_MAX_CONCURRENCY=2
REPORT_PLATFORM_CODEX_MAX_QUEUE_LENGTH=50
REPORT_PLATFORM_CODEX_QUEUE_WAIT_TIMEOUT_MS=120000

# Heavy MFL/layout PDF processing runs outside the API event loop in a bounded worker queue.
REPORT_PLATFORM_MFL_MAX_CONCURRENCY=1
REPORT_PLATFORM_MFL_MAX_QUEUE_LENGTH=8
REPORT_PLATFORM_MFL_QUEUE_WAIT_TIMEOUT_MS=120000
REPORT_PLATFORM_MFL_WORKER_TIMEOUT_MS=300000

# Targeted text edits are small interactive jobs. Keep their deadline shorter
# than whole-section generation so the editor returns a controlled retry state.
REPORT_PLATFORM_TARGETED_EDIT_TIMEOUT_MS=60000

# Optional local Vite proxy override when the default API port 8788 is occupied.
# REPORT_PLATFORM_VITE_API_ORIGIN=http://127.0.0.1:8790

# Password authentication is the only current report-platform login path.
# Create the first Super Admin once with `npm run account:bootstrap-admin`.
# Do not place account passwords in this runtime environment file.

# Session and login controls. Production cookies are Secure, HttpOnly and
# SameSite=Strict. Enable trust proxy only behind a controlled reverse proxy.
REPORT_PLATFORM_SESSION_TTL_MS=28800000
REPORT_PLATFORM_TRUST_PROXY=false

# Synthetic V10 data is an explicit demo facility, never a production fallback.
REPORT_PLATFORM_ENABLE_DEMO_DATA=false
REPORT_PLATFORM_ALLOW_LEGACY_SOURCE_IMPORTS=false

# Mac mini staging backup policy.
REPORT_PLATFORM_BACKUP_RETENTION_DAYS=14

# Required allowlist for production cross-origin deployments. Development mode
# accepts the Vite/Tailscale origin unless this setting is explicitly provided.
# REPORT_PLATFORM_ALLOWED_ORIGINS=https://reports.example.com

# Fixture fallback is disabled by default so backend/auth failures cannot be
# hidden by local mock data. Enable only for an explicit offline UI exercise.
VITE_REPORT_ALLOW_FIXTURE_FALLBACK=false
