# LAIQ Report Platform runtime AI settings
#
# GPT-5.6 Sol is the default worker target for the internal LAIQ AI Engine phase.
# The local Codex CLI must be 0.144.0 or newer for GPT-5.6; otherwise the
# backend will report deterministic fallback mode instead of running live AI.
REPORT_PLATFORM_CODEX_MODEL=gpt-5.6-sol

# Safety timeout for each Codex CLI worker call, in milliseconds.
# Keep this finite so section generation and chat edits cannot hang the demo.
REPORT_PLATFORM_CODEX_TIMEOUT_MS=120000

# Optional local Vite proxy override when the default API port 8788 is occupied.
# REPORT_PLATFORM_VITE_API_ORIGIN=http://127.0.0.1:8790

# Authentication mode. Development mode exposes controlled local identities
# and is rejected automatically when NODE_ENV=production.
REPORT_PLATFORM_AUTH_MODE=development

# Commercial OIDC mode requires all three values and pre-provisioned platform
# users whose provider/subject mapping matches the verified token.
# REPORT_PLATFORM_AUTH_MODE=oidc
# REPORT_PLATFORM_OIDC_PROVIDER_CODE=company-oidc
# REPORT_PLATFORM_OIDC_ISSUER=https://identity.example.com/
# REPORT_PLATFORM_OIDC_AUDIENCE=laiq-report-platform
# REPORT_PLATFORM_OIDC_JWKS_URI=https://identity.example.com/.well-known/jwks.json
# REPORT_PLATFORM_OIDC_LOGIN_URL=https://identity.example.com/authorize

# Required allowlist for production cross-origin deployments. Development mode
# accepts the Vite/Tailscale origin unless this setting is explicitly provided.
# REPORT_PLATFORM_ALLOWED_ORIGINS=https://reports.example.com

# Fixture fallback is disabled by default so backend/auth failures cannot be
# hidden by local mock data. Enable only for an explicit offline UI exercise.
VITE_REPORT_ALLOW_FIXTURE_FALLBACK=false
