    "title": "INSPECTION REPORT"
  },
  "plannedReleaseId": "inspection_report_v1",
  "status": "scaffold_ready",
  "productEnabled": false,
  "generationMode": "hybrid_deterministic_blocks_with_evidence_bound_ai_wording",
