  "prohibitedBehavior": [
    "raw_evidence_dump",
    "historical_finding_as_current_fact",
    "invented_satisfactory_condition",
    "automatic_fitness_for_service_conclusion",
    "full_measurement_table_as_prose",
    "use_target_report_structure_as_report_plan",
