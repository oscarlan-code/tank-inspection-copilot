  "evaluatorSpecFile": "evaluator-spec.json",
  "activePackageBoundCandidate": null,
  "historicalReleaseReferences": [],
  "knowledgeInputs": {
    "sectionKnowledgeBundle": "one_frozen_bundle_with_generation_projection",
