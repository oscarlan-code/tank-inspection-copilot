    {
      "blockId": "diked-area",
      "content": "Supported containment, surroundings and drainage observations.",
      "format": "report_plan_selected_allowed_format_family",
      "requiredWhen": "when_applicable"
    },
    {
      "blockId": "foundation",
      "content": "Supported foundation and observed settlement-effect findings.",
      "format": "report_plan_selected_allowed_format_family",
      "requiredWhen": "when_applicable"
    },
    {
      "blockId": "shell-external",
      "content": "External shell, coating, weld and deformation findings with locations.",
      "format": "report_plan_selected_allowed_format_family",
      "requiredWhen": "when_applicable"
    },
    {
      "blockId": "shell-appurtenances",
      "content": "Supported nozzle, manway and shell-fitting observations.",
      "format": "report_plan_selected_allowed_format_family",
      "requiredWhen": "when_applicable"
    },
    {
      "blockId": "access-structures",
      "content": "Supported stair, ladder, platform and handrail observations.",
      "format": "report_plan_selected_allowed_format_family",
      "requiredWhen": "when_applicable"
    },
    {
      "blockId": "roof-external",
      "content": "Configuration-specific external roof observations.",
      "format": "report_plan_selected_allowed_format_family",
      "requiredWhen": "when_applicable"
    },
    {
      "blockId": "roof-appurtenances",
      "content": "Supported roof opening, nozzle, vent and fitting observations.",
      "format": "report_plan_selected_allowed_format_family",
      "requiredWhen": "when_applicable"
    },
    {
      "blockId": "roof-internal",
      "content": "Supported roof underside and internal support observations.",
      "format": "report_plan_selected_allowed_format_family",
      "requiredWhen": "when_inspected"
    },
    {
      "blockId": "shell-internal",
      "content": "Supported internal shell, weld and coating observations.",
      "format": "report_plan_selected_allowed_format_family",
      "requiredWhen": "when_inspected"
    },
    {
      "blockId": "floor-internal",
      "content": "Supported floor, annular area, sump and shell-to-floor observations.",
      "format": "report_plan_selected_allowed_format_family",
      "requiredWhen": "when_inspected"
    },
    {
      "blockId": "assessment-summaries",
      "content": "Only reviewed selected quantitative or assessment summaries with exact protected values.",
      "format": "report_plan_selected_deterministic_assessment_format",
      "requiredWhen": "when_approved"
    }
  ],
  "outputBlockPolicy": {
    "catalogSource": "frozen_section_knowledge_bundle",
    "includeExcludeDecisionSource": "target_blind_frozen_report_plan",
    "displayHeadingAndFormatSource": "accepted_bundle_variants",
    "allSupportedBlocksRequiredInEveryReport": false,
    "unobservedBlockRequiresNewReviewedBundleVersion": true
  },
  "authorizedInputs": [
    "component_bound_findings",
    "checklist_observations",
    "routed_voice_claims",
    "selected_measurement_summaries",
    "test_summaries",
    "reviewed_assessments",
    "verified_photo_and_figure_references"
  ],
  "approvalBlockers": [
    "unresolved_component_or_location",
    "unresolved_internal_external_side",
    "polarity_or_uncertainty_conflict",
    "unsupported_quantitative_summary",
    "missing_material_finding_context"
