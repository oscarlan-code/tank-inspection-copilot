{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "laiq://report-platform/agent-execution-configuration-v1",
  "title": "Agent execution configuration",
  "type": "object",
  "required": [
    "contractVersion", "configurationId", "agentRole", "agentId", "releaseId",
    "releaseManifestSha256", "executionMode", "implementation", "model", "prompt",
    "knowledgeSnapshots", "schemaBindings", "configurationSha256"
  ],
  "properties": {
    "contractVersion": { "const": "agent_execution_configuration_v1" },
    "configurationId": { "type": "string", "minLength": 1 },
    "agentRole": { "type": "string" },
    "agentId": { "type": "string", "minLength": 1 },
    "releaseId": { "type": "string", "minLength": 1 },
    "releaseManifestSha256": { "$ref": "#/$defs/sha256" },
    "executionMode": { "enum": ["evaluation", "product"] },
    "implementation": {
      "type": "object",
      "required": ["gitCommit"],
      "properties": { "gitCommit": { "type": "string", "pattern": "^[a-f0-9]{40}$" } }
    },
    "model": { "type": "object", "required": ["mode"] },
    "prompt": { "type": "object", "required": ["mode"] },
    "knowledgeSnapshots": { "type": "array", "items": { "type": "object" } },
    "schemaBindings": { "type": "array", "minItems": 1, "items": { "type": "object" } },
    "evaluatorRubric": { "type": ["object", "null"] },
    "configurationSha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
