  "routingDefinitions": {
    "purpose": "Resolve section/block boundaries for evidence classification. These definitions do not create report facts or select the final table of contents.",
    "generalTankInformation": {
      "identity": [
        "client",
        "client representative",
        "job number",
        "tank number",
        "inspection or completion date",
        "location",
        "field or lease name"
      ],
      "configuration": [
        "year built",
        "service height",
        "tank dimensions",
        "roof type",
        "manufacturer"
      ],
      "design-data": [
        "shell joint or construction type",
        "construction standard",
        "material specification",
        "design pressure",
        "design temperature",
        "specific gravity",
        "stored product",
        "drawing reference with its subject"
      ],
      "inspection-history": [
        "previous inspection",
        "repair or alteration history",
        "re-bottoming history",
        "explicit status that previous external, internal, or bottom inspection history was not provided"
      ],
      "compoundClaimRule": "Split a construction fact and a later repair, alteration, inspection, or re-bottoming event into separate atoms before classification."
    },
    "scopeOfInspection": {
      "scope": "Use for planned coverage, components, deliverables, inclusions, or exclusions when the claim does not primarily define how the work will be performed.",
      "methods": "Use for a planned inspection technique, instrument, access method, sampling pattern, or measurement procedure.",
      "precedence": "When a bounded claim specifies both planned work and the technique or sampling pattern, methods is the more specific owner."
    },
    "recommendations": {
      "explicitActionPrecedence": "An explicit proposed action routes to repair-recommendations/recommendations even when the same claim cites an API clause or other technical basis.",
      "basisOnly": "Use repair-recommendations/basis only when the claim explains justification and contains no proposed action.",
      "monitoring": "An explicit instruction to monitor, recheck, or reassess routes to repair-recommendations/timing-and-monitoring."
    },
    "inspectionComponents": {
      "earthPointAttachedToShell": "inspection-report/shell-appurtenances",
      "foundationOrEarthingSystemWithoutShellAttachment": "inspection-report/foundation",
      "pipeSupportInDikedArea": "inspection-report/diked-area",
      "pipeSupportAttachedToShell": "inspection-report/shell-appurtenances"
    },
    "currentObservationVersusHistory": {
      "currentVisualInference": "An observation inferred from current physical evidence remains in the applicable inspection-report component block, including when the inferred event is uncertain.",
      "confirmedHistoricalEvent": "Use general-tank-information/inspection-history for a confirmed previous inspection, repair, alteration, replacement, or re-bottoming event.",
      "missingHistoryStatus": "An explicit statement that previous inspection history was not provided also belongs to general-tank-information/inspection-history; it is not an inspection-maintenance-regime limitation."
    },
    "inspectionAccessLimitations": {
      "completedComponentSpecific": "A past-tense statement that a named component was not accessed or inspected during the current inspection belongs to that inspection-report component block.",
      "plannedOrContractual": "A planned, agreed, contractual, or general exclusion belongs to scope-of-inspection/limitations."
    },
    "testInformation": {
      "calibrationStandardOrProcedure": "test-information/methods",
      "namedInstrumentOrCalibrationBlock": "test-information/equipment",
      "acceptanceCriterion": "test-information/methods when the governing test or structured test-field context is preserved; otherwise needs_review"
    },
    "missingContext": {
      "componentOrLocation": "Return zero uses with needs_review when the component or location changes the owner and cannot be resolved from the atom metadata.",
      "drawingReference": "A drawing number requires its subject or structured field provenance.",
      "manufacturer": "Preserve the field cue and value; a generic organization noun is insufficient."
    }
  },
