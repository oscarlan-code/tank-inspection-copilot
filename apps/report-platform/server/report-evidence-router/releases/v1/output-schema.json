{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "report_evidence_routing_v1",
  "type": "object",
  "required": ["contractVersion", "releaseId", "inputPackageHash", "evidenceLedger", "sectionEvidenceProjections", "routingReview", "routingManifest"],
  "properties": {
    "contractVersion": {"const": "report_evidence_routing_v1"},
    "releaseId": {"const": "report-evidence-router_v1"},
    "inputPackageHash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "evidenceLedger": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["evidenceId", "kind", "sourceRef", "quality", "uses", "disposition"],
        "properties": {
          "evidenceId": {"type": "string"},
          "kind": {"type": "string"},
          "sourceRef": {"type": "object"},
          "quality": {"type": "object"},
          "uses": {"type": "array"},
          "disposition": {
            "type": "object",
            "required": ["state", "reason"],
            "properties": {"state": {"enum": ["routed", "excluded", "needs_review"]}, "reason": {"type": "string"}}
          }
        }
      }
    },
    "sectionEvidenceProjections": {"type": "object", "additionalProperties": {"type": "object"}},
    "routingReview": {"type": "object"},
    "routingManifest": {"type": "object"}
  },
  "additionalProperties": false
}
